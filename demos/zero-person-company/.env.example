# zero-person-company demo env. Copy to .env.local and fill in.
# Sourced by scripts/dev.sh before starting the pinned vocion-core.

# Demo-specific overrides
PORT=3005
NEXT_PUBLIC_APP_URL=http://localhost:3005

# WORKSPACE_PATH is set by scripts/dev.sh — don't override here.

# ------------------------------------------------------------------------------
# Authentication — this core uses NextAuth, not Clerk.
# ------------------------------------------------------------------------------
# AUTH_SECRET — required. The umbrella bootstrap.sh generates one and writes
# it to this .env.local automatically. If you're setting up by hand,
# generate with: openssl rand -base64 32
AUTH_SECRET=replace_me_with_a_real_secret

# ------------------------------------------------------------------------------
# Database — points at the umbrella docker-compose Postgres. Give this demo
# its own database so `seed:demo` (which keys on user email) doesn't collide
# with another demo on the same instance.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vocion_zpc

# ------------------------------------------------------------------------------
# Demo credentials banner — autofilled on /sign-in. The seed:demo CLI creates
# a user with these creds; the sign-in page reads them via these env vars
# and offers an autofill button.
# ------------------------------------------------------------------------------
VOCION_DEMO_HINT_EMAIL=demo@example.com
VOCION_DEMO_HINT_PASSWORD=demo123

# ------------------------------------------------------------------------------
# LLM provider keys
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your_key_here
# OPENAI_API_KEY=sk-your_key_here

# ------------------------------------------------------------------------------
# App settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LOGGING_LEVEL=debug
NEXT_TELEMETRY_DISABLED=1
BILLING_PLAN_ENV=dev

# Disable Sentry locally
NEXT_PUBLIC_SENTRY_DISABLED=true
