# the manufacturer demo env. Copy to .env.local and fill in.
# Sourced by scripts/dev.sh before starting the pinned vocion-core.

# Demo-specific overrides
PORT=3004
NEXT_PUBLIC_APP_URL=http://localhost:3004

# WORKSPACE_PATH is set by scripts/dev.sh — don't override here.

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# AUTH_SECRET — required. Reuse the one the umbrella bootstrap.sh generated
# for the other apps (vocion-local/.bootstrap-secret) so sessions line up,
# or generate a fresh one: openssl rand -base64 32
AUTH_SECRET=replace_me_with_a_real_secret

# ------------------------------------------------------------------------------
# Database — its own DB on the umbrella docker-compose Postgres.
#
# Every demo gets its own database: seed:demo is keyed on user email and
# exits early if the user already exists, so two demos sharing a database
# can't both seed their own account + project.
#
# The umbrella's docker/postgres-init.sh creates vocion_kit_verification_qc on a FRESH
# volume. On an existing volume, create it once by hand:
#   docker exec vocion-postgres psql -U postgres -d postgres \
#     -c 'CREATE DATABASE vocion_kit_verification_qc'
#   docker exec vocion-postgres psql -U postgres -d vocion_kit_verification_qc \
#     -c 'CREATE EXTENSION IF NOT EXISTS vector'
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vocion_kit_verification_qc

# ------------------------------------------------------------------------------
# Demo credentials banner — autofilled on /sign-in. Distinct per demo so
# each can be seeded independently.
# ------------------------------------------------------------------------------
VOCION_DEMO_HINT_EMAIL=kitqc@example.com
VOCION_DEMO_HINT_PASSWORD=demo123

# ------------------------------------------------------------------------------
# LLM provider keys — prefer the umbrella-root .env (dev.sh sources it first
# so shell vars win). Only set here if running this demo standalone.
# ------------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# OPENAI_API_KEY=sk-your_key_here      # needed for embeddings on source sync

# ------------------------------------------------------------------------------
# App settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LOGGING_LEVEL=debug
NEXT_TELEMETRY_DISABLED=1
BILLING_PLAN_ENV=dev

# Disable Sentry locally
NEXT_PUBLIC_SENTRY_DISABLED=true

# Read by the vision_detect_labels tool (second opinion). Same project as KITQC_REKOGNITION_PROJECT_ARN.
VOCION_REKOGNITION_PROJECT_ARN=arn:aws:rekognition:us-east-1:<aws-account-id>:project/kitqc-condition/1788362445840
VOCION_REKOGNITION_REGION=us-east-1

# AWS — live services (metacto profile). Tagged Project=kitqc-demo, TearDown=true.
AWS_PROFILE=metacto
AWS_REGION=us-east-1
KITQC_S3_BUCKET=metacto-kitqc-demo-<aws-account-id>
KITQC_REKOGNITION_PROJECT_ARN=arn:aws:rekognition:us-east-1:<aws-account-id>:project/kitqc-condition/1788362445840
